---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, formatDate } from '../../lib/projects';
import { TRACKS, stageLabel } from '../../data/stages';

const projects = await getProjects();
---

<BaseLayout title="Проекты" description="Каталог проектов Ивана с текущими стадиями разработки.">
  <h1>Проекты</h1>
  {
    projects.length > 0 ? (
      <ul role="list" class="stack">
        {projects.map(({ id, data }) => (
          <li class="panel stack">
            <h2>
              <a href={`/projects/${id}/`}>{data.title}</a>
            </h2>
            <p>{data.summary}</p>
            <p class="meta">
              {TRACKS[data.track].label} · <span class="stage-current">{stageLabel(data.stage)}</span> · обновлено{' '}
              <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <div class="panel stack">
        <h2>Проекты скоро появятся</h2>
        <p>Каждый проект публикуется с первой стадии и обновляется по мере продвижения — от идеи до релиза.</p>
      </div>
    )
  }
</BaseLayout>
