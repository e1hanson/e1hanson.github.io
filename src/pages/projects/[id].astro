---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StageTiles from '../../components/StageTiles.astro';
import StageList from '../../components/StageList.astro';
import Timeline from '../../components/Timeline.astro';
import PrevNext from '../../components/PrevNext.astro';
import { getProjects, formatDate, type Project } from '../../lib/projects';
import { TRACKS, stageLabel, type StageId } from '../../data/stages';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: { project, prev: projects[index + 1], next: projects[index - 1] },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Дата прохождения каждой стадии — из хронологии
const dates: Partial<Record<StageId, Date>> = {};
for (const item of data.timeline) dates[item.stage] = item.date;

const links = [
  { href: data.links.demo, label: 'Открыть проект' },
  { href: data.links.repo, label: 'Исходный код' },
].filter((link): link is { href: string; label: string } => Boolean(link.href));
---

<BaseLayout title={data.title} description={data.summary}>
  <Breadcrumbs
    items={[{ href: '/', label: 'Главная' }, { href: '/projects/', label: 'Проекты' }, { label: data.title }]}
  />

  <header class="project-head golden golden-center">
    <div class="stack">
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <ul class="cluster" role="list">
        <li class="chip chip-now">{stageLabel(data.stage)}</li>
        <li class="chip">{TRACKS[data.track].label}</li>
        {data.tags.map((tag) => (
          <li class="chip">{tag}</li>
        ))}
      </ul>
      {links.length > 0 && (
        <div class="cluster project-head__links">
          {links.map(({ href, label }, index) => (
            <a class:list={['btn', { 'btn-primary': index === 0 }]} href={href} rel="noopener">
              {label}
            </a>
          ))}
        </div>
      )}
    </div>
    <div class="project-head__tiles">
      <StageTiles track={data.track} current={data.stage} labels />
    </div>
  </header>

  {data.cover && (
    <figure class="project-cover nm-pressed">
      <Image
        src={data.cover}
        alt={`Обложка проекта «${data.title}»`}
        widths={[610, 987, 1597, 2400]}
        sizes="(min-width: 1700px) 1597px, 94vw"
        loading="eager"
      />
    </figure>
  )}

  <section class="section golden" aria-labelledby="about-project">
    <div>
      <div class="section-head">
        <h2 id="about-project">О проекте</h2>
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
    <aside class="project-aside nm-raised panel" aria-labelledby="stages">
      <h2 id="stages" class="project-aside__title">
        Стадии
      </h2>
      <StageList track={data.track} current={data.stage} dates={dates} />
      <dl class="facts project-aside__facts">
        <div>
          <dt>Начат</dt>
          <dd>
            <time datetime={data.started.toISOString().slice(0, 10)}>{formatDate(data.started)}</time>
          </dd>
        </div>
        <div>
          <dt>Обновлён</dt>
          <dd>
            <time datetime={data.updated.toISOString().slice(0, 10)}>{formatDate(data.updated)}</time>
          </dd>
        </div>
        {data.stack.length > 0 && (
          <div>
            <dt>Инструменты</dt>
            <dd>{data.stack.join(', ')}</dd>
          </div>
        )}
      </dl>
    </aside>
  </section>

  {data.timeline.length > 0 && (
    <section class="section" aria-labelledby="timeline">
      <div class="section-head">
        <h2 id="timeline">Хронология</h2>
        <p class="muted">Что сделано на каждой стадии.</p>
      </div>
      <Timeline items={data.timeline} current={data.stage} />
    </section>
  )}

  <div class="section">
    <PrevNext prev={prev} next={next} />
  </div>
</BaseLayout>

<style>
  .project-head {
    margin-top: var(--sp-21);
  }

  .project-head__links {
    gap: var(--sp-21);
    padding-top: var(--sp-13);
  }

  .project-cover {
    margin-top: var(--sp-55);
    padding: var(--sp-13);
    border-radius: var(--r-panel);
  }

  .project-cover :global(img) {
    width: 100%;
    aspect-ratio: 1.618 / 1;
    object-fit: cover;
    border-radius: var(--r-card);
  }

  /* На широком экране обложка — φ² : 1, чтобы не вытеснять содержание за первый экран */
  @media (min-width: 1024px) {
    .project-cover :global(img) {
      aspect-ratio: 2.618 / 1;
    }
  }

  .project-aside {
    display: grid;
    gap: var(--sp-21);
  }

  .project-aside__title {
    font-size: var(--fs-2);
    font-weight: 400;
  }

  .project-aside__facts {
    padding-top: var(--sp-21);
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 1024px) {
    .project-aside {
      position: sticky;
      top: var(--sp-34);
    }
  }

  @media (max-width: 767.98px) {
    .project-head__tiles {
      max-width: 23.5625rem;
    }
  }
</style>
