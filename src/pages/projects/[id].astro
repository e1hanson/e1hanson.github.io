---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, formatDate, type Project } from '../../lib/projects';
import { TRACKS, stagesOf, stageLabel } from '../../data/stages';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const stages = stagesOf(data.track);
const currentIndex = stages.findIndex((s) => s.id === data.stage);
const timeline = [...data.timeline].sort((a, b) => a.date.valueOf() - b.date.valueOf());
---

<BaseLayout title={data.title} description={data.summary}>
  <nav aria-label="Хлебные крошки" class="meta">
    <a href="/projects/">Проекты</a> / {data.title}
  </nav>

  <h1>{data.title}</h1>
  <p class="lead">{data.summary}</p>
  <p class="meta">
    {TRACKS[data.track].label} · начат <time datetime={data.started.toISOString()}>{formatDate(data.started)}</time>
  </p>

  <section class="panel stack" aria-labelledby="stages">
    <h2 id="stages">Стадии</h2>
    <ol>
      {
        stages.map((stage, index) => (
          <li class={index === currentIndex ? 'stage-current' : undefined} aria-current={index === currentIndex ? 'step' : undefined}>
            {stage.label}
            {index < currentIndex && ' — пройдена'}
            {index === currentIndex && ' — сейчас'}
          </li>
        ))
      }
    </ol>
  </section>

  {
    timeline.length > 0 && (
      <section class="stack" aria-labelledby="timeline">
        <h2 id="timeline">Хронология</h2>
        <ol role="list" class="stack">
          {timeline.map((item) => (
            <li class="panel stack">
              <p class="meta">
                <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time> · {stageLabel(item.stage)}
              </p>
              <p>{item.note}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="stack" aria-labelledby="about-project">
    <h2 id="about-project">О проекте</h2>
    <Content />
  </section>
</BaseLayout>
