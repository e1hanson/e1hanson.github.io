---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена" noindex>
  <div class="section-head">
    <h1>Страница не найдена</h1>
    <p class="lead">По этому адресу ничего нет. Возможно, страница переехала или проект ещё не опубликован.</p>
  </div>
  <div class="cluster not-found__actions">
    <a class="btn btn-primary" href="/projects/">
      Перейти к проектам
    </a>
    <a class="btn" href="/">
      На главную
    </a>
  </div>
</BaseLayout>

<style>
  .not-found__actions {
    gap: var(--sp-21);
  }
</style>
